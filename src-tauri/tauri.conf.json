{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SilentHuddle",
  "version": "1.4.1",
  "identifier": "com.silenthuddle.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SilentHuddle",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "SilentHuddle Labs",
    "copyright": "Copyright © 2026 SilentHuddle Labs. All rights reserved.",
    "category": "SocialNetworking",
    "shortDescription": "Private peer-to-peer conversations.",
    "longDescription": "SilentHuddle is a private peer-to-peer communication app with messaging, file transfer, voice, video and screen sharing.",
    "homepage": "https://silenthuddle.example",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
